# FreshBooks API Credentials
# Get these from: https://my.freshbooks.com/#/developer

FRESHBOOKS_CLIENT_ID=your_client_id_here
FRESHBOOKS_CLIENT_SECRET=your_client_secret_here

# OAuth Redirect URI
# FreshBooks requires HTTPS and rejects localhost. By default fb uses the hosted
# relay below, which forwards the login to fb on 127.0.0.1:8374. Register this
# exact URI on your FreshBooks app. Leave it as is unless you run your own tunnel
# (for example ngrok: ngrok http 8374, then use https://<ngrok-host>/callback).
FRESHBOOKS_REDIRECT_URI=https://freshbooks-tools.wecodefire.com/callback

# Optional: Custom local port for OAuth callback (default: 8374)
# Only works with your own tunnel; the hosted relay always forwards to 8374.
# FRESHBOOKS_LOCAL_PORT=8374
